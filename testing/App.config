<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    
  <sectionGroup name="common">
      <section name="logging" type="Common.Logging.ConfigurationSectionHandler, Common.Logging" />
    </sectionGroup><section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" /></configSections>
  
  <appSettings>
    <add key="redmine-url" value="https://im.owdev.net" />
    <add key="accountSid" value="starix.automail" />
    <add key="secretKey" value="Cn8hdjvyaLd9gmMrw0+XWw==" />
    <add key="ReportedDateCustomFieldId" value="35" />
    <add key="ResolvedDateCustomFieldId" value="36" />
    <!-- If Custome field time zone is understanded as GMT+7, then value is 7 -->
    <add key="CustomFieldTimeZone" value="8" />
    <add key="KnowErrorCustomFieldId" value="40" />
    <add key="RequestForChangeCustomFieldId" value="39" />
    <add key="LogCategory" value="incident-report-service" />
    <add key="SentryUrl" value="https://1ed65682e0724701bccb6d663cdeae40@sentry.nexdev.net/101" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="RabbitMQ.Client" publicKeyToken="89e7d7c5feba84ce" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.4.0" newVersion="3.5.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="log4net" publicKeyToken="669e0ddf0bb1aa2a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.2.15.0" newVersion="1.2.15.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.InteropServices.RuntimeInformation" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.2.0" newVersion="4.0.2.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

<common>
    <logging>
      <factoryAdapter type="Common.Logging.Log4Net.Universal.Log4NetFactoryAdapter, Common.Logging.Log4Net.Universal" />
    </logging>
  </common>
  <Fanex.MailDelivery.Client applicationSendMailId="1" siteId="3" rabbitMQConnectionString="host=ha.nexdev.net:5672;virtualHost=/MailStationHost;username=rabbitclient;timeout=120">
    <Functions>
      <!--<add id="1" name="YourFunction" />-->
    </Functions>
    <Schedules>
      <Schedule id="234" name="Weekly Incident Management Report Service" job="Fanex.IncidentManagementReport.Service.Job.IncidentWeeklyReportJob, Fanex.IncidentManagementReport.Service" />
      <Schedule id="238" name="Daily Incident Management Report Service" job="Fanex.IncidentManagementReport.Service.Job.IncidentDailyReportJob, Fanex.IncidentManagementReport.Service" />
      <Schedule id="269" name="Weekly Problem Management Report Service" job="Fanex.IncidentManagementReport.Service.Job.ProblemWeeklyReportJob, Fanex.IncidentManagementReport.Service" />
    </Schedules>
  </Fanex.MailDelivery.Client>
</configuration>
