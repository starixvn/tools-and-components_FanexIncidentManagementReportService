<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
  </configSections>
  <appSettings>
    <add key="redmine-url" value="https://demo2.starixsoft.com" />
    <add key="accountSid" value="quinn.vo" />
    <add key="secretKey" value="JpzecIk2Sug=" />
    <!-- user/pass login IM -->
    <add key="ReportedDateCustomFieldId" value="35"/>
    <add key="ResolvedDateCustomFieldId" value="36"/>
    <add key="KnowErrorCustomFieldId" value="37"/>
    <add key="RequestForChangeCustomFieldId" value="39"/>
    <!-- If Custome field time zone is understanded as GMT+7, then value is 7 -->
    <add key="CustomFieldTimeZone" value="8"/>
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>
  <system.data>
    <DbProviderFactories>
      <remove invariant="MySql.Data.MySqlClient" />
      <add name="MySQL Data Provider" invariant="MySql.Data.MySqlClient" description=".Net Framework Data Provider for MySQL" type="MySql.Data.MySqlClient.MySqlClientFactory, MySql.Data, Version=6.9.9.0, Culture=neutral, PublicKeyToken=c5687fc88969c44d" />
    </DbProviderFactories>
  </system.data>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />

    </providers>
  </entityFramework>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="MySql.Data" publicKeyToken="c5687fc88969c44d" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.9.9.0" newVersion="6.9.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="RabbitMQ.Client" publicKeyToken="89e7d7c5feba84ce" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.4.0" newVersion="3.5.4.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <Fanex.MailDelivery.Client environment="local" applicationSendMailId="1" siteId="3" rabbitMQConnectionString="host=10.18.200.104;virtualHost=/QCLocalTest;username=rabbitclient;timeout=3600" messageBrokerLogCategory="MailCentralized">
    <Functions>
      <!--<add id="1" name="YourFunction" />-->
    </Functions>
    <Schedules>
      <!--<Schedule id="2" name="YourSchedule" job="YourProject.Namespace.Job, YourProject">-->
      <Schedule id="234" name="Weekly Incident Management Report Service" job="Fanex.IncidentManagementReport.Service.Job.IncidentWeeklyReportJob, Fanex.IncidentManagementReport.Service" />
      <Schedule id="238" name="Daily Incident Management Report Service" job="Fanex.IncidentManagementReport.Service.Job.IncidentDailyReportJob, Fanex.IncidentManagementReport.Service" />
      <Schedule id="269" name="Weekly Problem Management Report Service" job="Fanex.IncidentManagementReport.Service.Job.ProblemWeeklyReportJob, Fanex.IncidentManagementReport.Service" />
    </Schedules>
  </Fanex.MailDelivery.Client>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" />
</configuration>
